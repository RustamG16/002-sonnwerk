---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { brand } from '../content/site';
import { withBase } from '../lib/base';

interface Props { title: string; description?: string; jsonLd?: object; ogImage?: string }
const { title, description = `${brand.name} — ${brand.claim} BIO-CBD vom eigenen Hofkollektiv in Österreich.`, jsonLd, ogImage = withBase('/og.jpg') } = Astro.props;
---
<!doctype html>
<html lang="de">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={brand.tokens.bg} />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Space+Grotesk:wght@400;500&display=swap" rel="stylesheet" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="grain">
    <a href="#main" class="skip-link">Zum Inhalt springen</a>
    <Header />
    <span id="main" tabindex="-1"></span>
    <slot />
    <Footer />
    <CartDrawer />
    <script src="../scripts/header.js"></script>
    <script src="../scripts/cart.js"></script>
    <script src="../scripts/motion.js"></script>
  </body>
</html>
