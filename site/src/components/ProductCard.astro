---
import { euro, type Product } from '../content/site';
import HoverMedia from './HoverMedia.astro';
interface Props { product: Product }
const { product } = Astro.props;
---
<article class="card reveal">
  <a href={`/produkt/${product.slug}/`} class="media-wrap">
    <HoverMedia poster={product.image} alt={product.name} loopKey={product.category} />
  </a>
  <div class="body">
    <h3 class="serif"><a href={`/produkt/${product.slug}/`}>{product.name}</a></h3>
    <p class="dim short">{product.short}</p>
    <div class="row">
      <span class="price gold serif">{euro(product.price)}</span>
      <button type="button" class="btn add" data-add-to-cart data-slug={product.slug} data-name={product.name} data-price={product.price}>
        In den Warenkorb
      </button>
    </div>
  </div>
</article>

<style>
  .card { display: flex; flex-direction: column; }
  .media-wrap { display: block; aspect-ratio: 1; overflow: hidden; }
  .media-wrap :global(.hover-media) { height: 100%; aspect-ratio: 1; }
  .body { padding: 18px 0 8px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  h3 { font-size: 1.25rem; }
  h3 a { transition: color 0.2s; }
  h3 a:hover { color: var(--gold); }
  .short { font-size: 0.88rem; flex: 1; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 6px; }
  .price { font-size: clamp(1.35rem, 2.5vw, 1.75rem); letter-spacing: -0.02em; line-height: 1; }
  .add { padding: 0.6rem 1.1rem; font-size: 0.7rem; flex-shrink: 0; }
</style>
