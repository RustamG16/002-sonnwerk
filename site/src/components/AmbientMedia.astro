---
/* Ambient-loop pattern: the poster <img> is always the layout-defining element (normal
   flow, real height) so the container never collapses while a src is unset or 404s. The
   <video> layers on top absolutely and only becomes visible once it fires canplay. */
interface Props { src: string | null; poster: string; alt: string; class?: string }
const { src, poster, alt, class: cls = '' } = Astro.props;
---
<div class={`ambient ${cls}`}>
  <img src={poster} alt={alt} loading="lazy" data-ambient-poster />
  {src && (
    <video muted autoplay loop playsinline preload="none" poster={poster} aria-label={alt} data-ambient-video>
      <source src={src} type="video/mp4" />
    </video>
  )}
</div>

<style>
  .ambient { position: relative; overflow: hidden; }
  .ambient :global(img), .ambient :global(video) { width: 100%; object-fit: cover; aspect-ratio: 16 / 9; }
  .ambient :global(img) { position: relative; height: auto; }
  .ambient :global(video) {
    position: absolute; inset: 0; height: 100%;
    opacity: 0; transition: opacity 0.5s ease;
  }
  .ambient :global(video.is-ready) { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .ambient :global(video) { display: none; }
  }
</style>
