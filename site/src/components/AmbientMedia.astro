---
/* Ambient-loop pattern (lab/001 §4a): poster-first native <video>; while Gate 2 media
   is pending (src=null) render the poster only. prefers-reduced-motion → poster via CSS. */
interface Props { src: string | null; poster: string; alt: string; class?: string }
const { src, poster, alt, class: cls = '' } = Astro.props;
---
{src ? (
  <div class={`ambient ${cls}`}>
    <video muted autoplay loop playsinline preload="metadata" poster={poster} aria-label={alt}>
      <source src={src} type="video/mp4" />
    </video>
    <img src={poster} alt={alt} class="poster-fallback" loading="lazy" />
  </div>
) : (
  <div class={`ambient ${cls}`}>
    <img src={poster} alt={alt} loading="lazy" />
  </div>
)}

<style>
  .ambient { position: relative; overflow: hidden; }
  .ambient :global(video), .ambient :global(img) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 16 / 9; }
  .poster-fallback { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .ambient :global(video) { display: none; }
    .poster-fallback { display: block; }
  }
</style>
