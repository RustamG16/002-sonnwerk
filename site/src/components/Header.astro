---
const links = [
  { href: '/shop/', label: 'Shop' },
  {
    href: '/hof/', label: 'Der Hof',
    children: [
      { href: '/hof/', label: 'Der Hof' },
      { href: '/arbeit-mit-dem-pferd/', label: 'Arbeit mit dem Pferd' },
      { href: '/galerie/', label: 'Galerie' },
    ],
  },
];
---
<header class="site-header" data-site-header>
  <div class="bar">
    <a href="/" class="logo serif">
      <img src="/logo-mark.png" alt="" width="34" height="34" />
      SONN<span class="gold">WERK</span>
    </a>

    <nav class="nav-desktop" aria-label="Hauptnavigation">
      {links.map((l) => (
        l.children ? (
          <div class="nav-item">
            <a href={l.href} aria-haspopup="true">{l.label}</a>
            <div class="dropdown">
              {l.children.map((c) => <a href={c.href}>{c.label}</a>)}
            </div>
          </div>
        ) : (
          <a href={l.href}>{l.label}</a>
        )
      ))}
      <button type="button" class="cart-btn" data-cart-open aria-label="Warenkorb öffnen">
        Warenkorb <span class="cart-count" data-cart-count>0</span>
      </button>
    </nav>

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Menü öffnen"
    >
      <span class="bar-top"></span>
      <span class="bar-bot"></span>
    </button>
  </div>
</header>

<nav id="mobile-nav" class="mobile-nav" data-mobile-nav aria-label="Mobile Navigation" aria-hidden="true">
  <ul class="mobile-links">
    {links.map((l, i) => (
      <li style={`--i: ${i}`}>
        <a href={l.href} data-mobile-link>{l.label}</a>
        {l.children && (
          <ul class="mobile-sublinks">
            {l.children.map((c) => <li><a href={c.href} data-mobile-link>{c.label}</a></li>)}
          </ul>
        )}
      </li>
    ))}
    <li style={`--i: ${links.length}`}>
      <button type="button" class="mobile-cart" data-mobile-cart data-cart-open>Warenkorb</button>
    </li>
  </ul>
</nav>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 50;
    background: linear-gradient(to bottom, rgba(13, 20, 8, 0.85), rgba(13, 20, 8, 0));
    backdrop-filter: blur(2px);
    transition: background 0.4s var(--spring), backdrop-filter 0.4s var(--spring);
  }
  .site-header.scrolled {
    background: rgba(13, 20, 8, 0.72);
    backdrop-filter: blur(12px);
  }

  /* Cream content scrolling under the header: invert instead of clipping/muddying the headline. */
  .site-header.theme-paper {
    background: rgba(242, 235, 220, 0.86);
    backdrop-filter: blur(12px);
  }
  .site-header.theme-paper .logo,
  .site-header.theme-paper .nav-desktop a,
  .site-header.theme-paper .cart-btn { color: var(--bg); }
  .site-header.theme-paper .nav-desktop a:hover { color: var(--bg); }
  .site-header.theme-paper .cart-btn { border-color: rgba(13, 20, 8, 0.3); }
  .site-header.theme-paper .cart-btn:hover { border-color: var(--gold); }
  .site-header.theme-paper .nav-toggle span { background: var(--bg); }

  .bar {
    display: flex; align-items: center; justify-content: space-between;
    height: 72px;
    padding-inline: var(--edge);
    transition: height 0.4s var(--spring);
  }
  .site-header.scrolled .bar { height: 56px; }

  .logo {
    font-size: 1.35rem; letter-spacing: 0.14em;
    display: flex; align-items: center; gap: 10px;
    transition: transform 0.4s var(--spring);
  }
  .site-header.scrolled .logo { transform: scale(0.92); transform-origin: left center; }
  .logo img { width: 34px; height: 34px; transition: width 0.4s var(--spring), height 0.4s var(--spring); }
  .site-header.scrolled .logo img { width: 30px; height: 30px; }

  .nav-desktop { display: flex; align-items: center; gap: clamp(16px, 3vw, 36px); }
  .nav-desktop a {
    position: relative;
    font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--cream-dim); transition: color 0.25s;
  }
  .nav-desktop a::after {
    content: ''; position: absolute; left: 0; bottom: -4px;
    height: 1px; width: 0; background: var(--gold);
    transform-origin: left;
    transition: width 0.35s cubic-bezier(0.2, 0.9, 0.2, 1);
  }
  .nav-desktop a:hover { color: var(--paper); }
  .nav-desktop a:hover::after { width: 100%; }

  .nav-item { position: relative; }
  .dropdown {
    position: absolute; top: 100%; left: 50%; transform: translateX(-50%) translateY(-6px);
    margin-top: 14px; padding: 10px 0; min-width: 200px;
    background: rgba(13, 20, 8, 0.94); backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    display: flex; flex-direction: column;
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.25s var(--spring), transform 0.25s var(--spring), visibility 0.25s;
  }
  /* Invisible hover bridge over the 14px gap above the panel — without it, moving the
     cursor from the trigger toward a submenu item crosses dead space and drops :hover,
     closing the menu before the pointer ever reaches a link. Panel background/position
     is untouched; this only extends the hoverable box upward. */
  .dropdown::before {
    content: ''; position: absolute; left: 0; right: 0; top: -14px; height: 14px;
  }
  .site-header.theme-paper .dropdown { background: rgba(242, 235, 220, 0.96); border-color: rgba(13, 20, 8, 0.14); }
  .nav-item:hover .dropdown,
  .nav-item:focus-within .dropdown,
  .nav-item.is-open .dropdown {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0);
  }
  .dropdown a {
    padding: 10px 20px; text-align: left; white-space: nowrap;
    font-size: 0.75rem; letter-spacing: 0.14em;
  }
  .dropdown a::after { display: none; }
  .dropdown a:hover { background: rgba(232, 163, 61, 0.1); }

  .mobile-sublinks {
    list-style: none; padding: 0; margin-top: 10px;
    display: flex; flex-direction: column; gap: 10px;
  }
  /* .mobile-links .mobile-sublinks a (not just .mobile-sublinks a) so this reliably beats
     the .mobile-links a rule further down regardless of source order — same specificity
     otherwise, and cascade order alone is too fragile here. */
  .mobile-links .mobile-sublinks a {
    font-family: var(--sans); font-size: 0.95rem; letter-spacing: 0.04em;
    color: var(--cream-dim);
  }
  .mobile-links .mobile-sublinks a:hover { color: var(--gold); }

  .cart-btn {
    background: none; border: 1px solid var(--line); color: var(--paper);
    padding: 0.45rem 0.9rem; font-size: 0.8rem; letter-spacing: 0.2em; text-transform: uppercase;
    display: flex; align-items: center; gap: 0.5rem; transition: border-color 0.2s;
  }
  .cart-btn:hover { border-color: var(--gold); }
  .cart-count {
    background: var(--gold); color: var(--bg); min-width: 1.3em; text-align: center;
    font-size: 0.75rem; padding: 0.05em 0.3em;
  }

  .nav-toggle {
    display: none;
    position: relative; width: 44px; height: 44px;
    background: none; border: none; padding: 0;
  }
  .nav-toggle span {
    position: absolute; left: 10px; right: 10px; height: 1px;
    background: var(--paper);
    transition: transform 0.4s var(--spring), top 0.4s var(--spring), opacity 0.3s;
  }
  .bar-top { top: 17px; }
  .bar-bot { top: 27px; }
  .nav-toggle.is-open .bar-top { top: 22px; transform: rotate(45deg); }
  .nav-toggle.is-open .bar-bot { top: 22px; transform: rotate(-45deg); }

  .mobile-nav {
    position: fixed; inset: 0; z-index: 60;
    background: var(--bg);
    display: flex; align-items: center; justify-content: center;
    visibility: hidden; opacity: 0;
    transition: visibility 0.4s, opacity 0.4s var(--spring);
    pointer-events: none;
  }
  .mobile-nav.is-open {
    visibility: visible; opacity: 1; pointer-events: auto;
  }
  .mobile-links {
    list-style: none; display: flex; flex-direction: column; gap: clamp(24px, 5vw, 40px);
    text-align: center; padding: 0;
  }
  .mobile-links a,
  .mobile-cart {
    font-family: var(--serif); font-size: clamp(2rem, 8vw, 3.2rem);
    letter-spacing: -0.02em; color: var(--paper);
    background: none; border: none; cursor: pointer;
    opacity: 0; transform: translateY(16px);
    transition: opacity 0.45s var(--spring), transform 0.45s var(--spring), color 0.2s;
    transition-delay: calc(var(--i) * 60ms);
  }
  .mobile-nav.is-open .mobile-links a,
  .mobile-nav.is-open .mobile-cart {
    opacity: 1; transform: none;
  }
  .mobile-links a:hover,
  .mobile-cart:hover { color: var(--gold); }

  @media (max-width: 720px) {
    .nav-desktop { display: none; }
    .nav-toggle { display: block; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header, .bar, .logo, .logo img, .nav-desktop a::after,
    .nav-toggle span, .mobile-nav, .mobile-links a, .mobile-cart {
      transition: none;
    }
    .mobile-links a, .mobile-cart { opacity: 1; transform: none; }
  }
</style>
