---
import { checkout } from '../content/site';
---
<div class="cart-overlay" data-cart-overlay aria-hidden="true"></div>
<aside class="cart-drawer" data-cart-drawer aria-label="Warenkorb" aria-hidden="true">
  <div class="head">
    <h3>Warenkorb</h3>
    <button type="button" data-cart-close aria-label="Schließen">×</button>
  </div>
  <div class="items" data-cart-items>
    <p class="dim empty">Dein Warenkorb ist leer.</p>
  </div>
  <div class="foot">
    <p class="total">Zwischensumme <strong data-cart-total>€0,00</strong></p>
    <a class="btn btn--solid btn--wide" href={checkout.wooCheckoutUrl} data-cart-checkout>Zur Kasse</a>
  </div>
</aside>

<style>
  .cart-overlay {
    position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 98;
    opacity: 0; visibility: hidden; pointer-events: none;
    transition: opacity 0.35s ease, visibility 0.35s ease;
  }
  .cart-overlay.is-open { opacity: 1; visibility: visible; pointer-events: auto; }

  .cart-drawer {
    position: fixed; top: 0; right: 0; bottom: 0; width: min(420px, 92vw); z-index: 99;
    background: var(--bg); border-left: 1px solid var(--line);
    display: flex; flex-direction: column; padding: 28px;
    transform: translateX(100%);
    transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.2, 1);
  }
  .cart-drawer.is-open { transform: translateX(0); }

  .head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .head button { background: none; border: none; color: var(--paper); font-size: 1.8rem; line-height: 1; }
  .items { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 16px; }
  .empty { padding-top: 24px; }
  .foot { border-top: 1px solid var(--line); padding-top: 20px; }
  .total { display: flex; justify-content: space-between; margin-bottom: 16px; }
  .total strong { color: var(--gold); }
  :global(.cart-line) { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; font-size: 0.95rem; }
  :global(.cart-line .qty-controls) { display: flex; gap: 8px; align-items: center; }
  :global(.cart-line button) { background: none; border: 1px solid var(--line); color: var(--paper); width: 24px; height: 24px; line-height: 1; }
  :global(.cart-line .price) { color: var(--gold); white-space: nowrap; }

  @media (prefers-reduced-motion: reduce) {
    .cart-overlay, .cart-drawer { transition: none; }
  }
</style>
