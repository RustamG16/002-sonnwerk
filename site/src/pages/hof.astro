---
import { withBase } from '../lib/base';
import Base from '../layouts/Base.astro';
import AmbientMedia from '../components/AmbientMedia.astro';
import { ambient } from '../content/site';

const sections = [
  {
    id: 'hanf', eyebrow: 'Unser Hanf', title: 'Vom Samen zum Öl.',
    copy: 'Auf unseren Feldern in Österreich wächst Hanf aus zertifiziertem Bio-Saatgut. Keine Pestizide, kein Kunstdünger — nur Sonne, Boden und Zeit. Jede Pflanze wird von Hand geerntet und schonend verarbeitet.',
    media: { src: null, poster: withBase('/media/galerie/ernte.webp'), alt: 'Hanf wird von Hand geerntet' },
  },
  {
    id: 'pferd', eyebrow: 'Arbeit mit dem Pferd', title: 'Kraft, die den Boden schont.',
    copy: 'Wo andere den Traktor starten, spannen wir ein. Die Arbeit mit dem Pferd verdichtet den Boden nicht, hält den Hof leise und uns ehrlich. Es ist langsamer. Genau deshalb machen wir es.',
    media: ambient.horses,
    moreLink: withBase('/arbeit-mit-dem-pferd/'),
  },
  {
    id: 'kutschenfahrten', eyebrow: 'Kutschenfahrten', title: 'Der Hof, vom Kutschbock aus.',
    copy: 'Erlebe das Hofkollektiv bei einer Kutschenfahrt durch Felder und Wald — mit denselben Pferden, die unsere Felder bestellen. Anfragen gerne per E-Mail oder Telefon.',
    media: ambient.harness,
  },
];
---
<Base title="Der Hof — Vom Samen zum Öl | SONNWERK">
  <main class="hof">
    <header class="hero">
      <AmbientMedia {...ambient.feld} class="bg" />
      <div class="overlay"></div>
      <div class="wrap copy">
        <p class="eyebrow">Das Hofkollektiv</p>
        <h1>Der Hof hinter der Flasche.</h1>
        <p class="dim sub">Ein Hof in Österreich. Hanf, Pferde und die Überzeugung, dass man Qualität nicht abkürzen kann.</p>
      </div>
    </header>

    {sections.map((s, i) => (
      <section id={s.id} class={`story ${i % 2 ? 'flip' : ''}`}>
        <div class="media reveal"><AmbientMedia {...s.media} /></div>
        <div class="text">
          <p class="eyebrow reveal">{s.eyebrow}</p>
          <h2 class="reveal">{s.title}</h2>
          <p class="dim reveal">{s.copy}</p>
          {s.moreLink && <a href={s.moreLink} class="more-link reveal">Mehr dazu →</a>}
        </div>
      </section>
    ))}

    <section class="cta paper-section">
      <div class="wrap">
        <h2 class="reveal">Schmeck den Unterschied.</h2>
        <p class="dim reveal">Alles, was wir hier anbauen, findest Du im Shop — vom Feld in die Flasche.</p>
        <a href={withBase('/shop/')} class="btn btn--ink reveal">Zum Shop</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .hero { position: relative; height: 92vh; display: flex; align-items: flex-end; }
  .hero :global(.bg) { position: absolute; inset: 0; }
  .hero :global(.bg img), .hero :global(.bg video) { height: 100%; aspect-ratio: auto; }
  .overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, var(--bg), rgba(13,20,8,0.25)),
      linear-gradient(135deg, rgba(232, 163, 61, 0.1), transparent 55%);
  }
  .copy { position: relative; z-index: 2; padding-bottom: 90px; }
  .sub { max-width: 520px; margin-top: 16px; font-size: 1.1rem; }

  .story {
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 80px);
    align-items: center; padding: 110px var(--edge);
  }
  .story.flip .media { order: 2; }
  .story h2 { margin: 12px 0 18px; }
  .story .dim { max-width: 480px; }

  /* Pass 2 Phase D: feathered edges + a palette tint so photos blend into the page
     instead of reading as rectangles on a flat background. CSS only, no new assets.
     Deliberately not applied to the pferd page's .chapter-media — those already animate
     clip-path for the masked reveal, and a second static mask on the same element fights
     the first (files/2026-07-26-pass2-proximity-crop-and-blend-plan.md §Phase D). */
  .story .media { position: relative; --feather: clamp(20px, 4vw, 64px); }
  .story .media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: var(--gold); mix-blend-mode: overlay; opacity: 0.3;
  }
  .story .media::before {
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 1;
    background: var(--bg); mix-blend-mode: multiply; opacity: 0.12;
  }
  .story .media :global(img) {
    filter: saturate(0.82) contrast(1.04);
  }
  @supports (mask-composite: intersect) or (-webkit-mask-composite: source-in) {
    .story .media :global(img) {
      mask-image:
        linear-gradient(to right,  transparent, #000 var(--feather), #000 calc(100% - var(--feather)), transparent),
        linear-gradient(to bottom, transparent, #000 var(--feather), #000 calc(100% - var(--feather)), transparent);
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
    }
  }
  @media (max-width: 800px) {
    .story .media { --feather: 20px; }
  }
  .more-link {
    display: inline-block; margin-top: 20px;
    font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--gold);
    border-bottom: 1px solid transparent; transition: border-color 0.25s;
  }
  .more-link:hover { border-color: var(--gold); }

  .cta { text-align: center; padding: 130px 0; }
  .cta h2 { margin-bottom: 14px; }
  .cta .btn { margin-top: 28px; }
  .cta .dim { max-width: 480px; margin: 0 auto; }

  @media (max-width: 800px) {
    .story { grid-template-columns: 1fr; }
    .story.flip .media { order: 0; }
  }
</style>
